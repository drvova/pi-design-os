{
  "name": "pi-design-os",
  "version": "0.1.1",
  "description": "Explore design directions from your coding agent, and read them off real sites. Local-first.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvova/pi-design-os.git"
  },
  "homepage": "https://github.com/drvova/pi-design-os#readme",
  "bugs": {
    "url": "https://github.com/drvova/pi-design-os/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "design",
    "clone",
    "chrome-devtools-protocol",
    "feature-sliced-design"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "design-os": "bin/design-os.js",
    "design-os-mcp": "bin/design-os-mcp.js"
  },
  "pi": {
    "extensions": [
      "./extensions/design-os.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "mcp": {
    "name": "design-os",
    "description": "Read a website's rendering pipeline and design, or clone it into a runnable local copy.",
    "command": "design-os-mcp",
    "args": []
  },
  "scripts": {
    "test": "node --test",
    "directions": "node bin/design-os.js directions",
    "inspect": "node bin/design-os.js inspect",
    "mcp": "node bin/design-os.js mcp"
  },
  "files": [
    "LICENSE",
    "bin",
    "examples",
    "extensions",
    "skills",
    "src"
  ],
  "optionalDependencies": {
    "element-source": "^0.0.5"
  }
}
